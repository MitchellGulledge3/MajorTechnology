{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspace": {
            "type": "string",
            "metadata": {
                "description": "The name of the Log Analytics / Microsoft Sentinel workspace."
            }
        },
        "workspaceResourceId": {
            "type": "string",
            "metadata": {
                "description": "Full resource ID of the Log Analytics workspace: /subscriptions/{sub}/resourceGroups/{rg}/providers/Microsoft.OperationalInsights/workspaces/{name}"
            }
        }
    },
    "variables": {
        "location": "[resourceGroup().location]",
        "dceName": "[concat('dce-majorbuild-', uniqueString(resourceGroup().id))]",
        "dcrName": "MajorBuildInvocationsDCR",
        "connectorDefinitionName": "MajorBuildInvocationsDefinition",
        "tableName": "MajorBuildInvocations_CL",
        "streamName": "Custom-MajorBuildInvocations_CL",
        "workspaceSubscriptionId": "[split(parameters('workspaceResourceId'), '/')[2]]",
        "workspaceResourceGroup": "[split(parameters('workspaceResourceId'), '/')[4]]"
    },
    "resources": [
        {
            "comments": "1. Data Collection Endpoint",
            "type": "Microsoft.Insights/dataCollectionEndpoints",
            "apiVersion": "2022-06-01",
            "name": "[variables('dceName')]",
            "location": "[variables('location')]",
            "properties": {
                "networkAcls": {
                    "publicNetworkAccess": "Enabled"
                }
            }
        },
        {
            "comments": "2. Custom Log Analytics Table",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "createMajorBuildTable",
            "subscriptionId": "[variables('workspaceSubscriptionId')]",
            "resourceGroup": "[variables('workspaceResourceGroup')]",
            "properties": {
                "mode": "Incremental",
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "resources": [
                        {
                            "name": "[concat(parameters('workspace'), '/', variables('tableName'))]",
                            "type": "Microsoft.OperationalInsights/workspaces/tables",
                            "apiVersion": "2022-10-01",
                            "tags": {
                                "DataSource": "Major.build",
                                "Category": "SecurityInsights",
                                "CreatedFrom": "DCR-StreamDeclaration",
                                "Method": "CustomTransformation"
                            },
                            "properties": {
                                "retentionInDays": 180,
                                "schema": {
                                    "name": "[variables('tableName')]",
                                    "description": "Major.build AI agent invocation logs \u2014 captures account, user, application, resource, and full request payload for every agent invocation. accountName identifies the connected Major.build account.",
                                    "columns": [
                                        {
                                            "name": "TimeGenerated",
                                            "type": "datetime"
                                        },
                                        {
                                            "name": "accountName",
                                            "type": "string"
                                        },
                                        {
                                            "name": "invocationId",
                                            "type": "string"
                                        },
                                        {
                                            "name": "invocationTime",
                                            "type": "string"
                                        },
                                        {
                                            "name": "resourceName",
                                            "type": "string"
                                        },
                                        {
                                            "name": "applicationName",
                                            "type": "string"
                                        },
                                        {
                                            "name": "resourceType",
                                            "type": "string"
                                        },
                                        {
                                            "name": "environment",
                                            "type": "string"
                                        },
                                        {
                                            "name": "userName",
                                            "type": "string"
                                        },
                                        {
                                            "name": "userEmail",
                                            "type": "string"
                                        },
                                        {
                                            "name": "status",
                                            "type": "string"
                                        },
                                        {
                                            "name": "payload",
                                            "type": "dynamic"
                                        },
                                        {
                                            "name": "payloadSubtype",
                                            "type": "string"
                                        },
                                        {
                                            "name": "payloadTimeoutMs",
                                            "type": "int"
                                        },
                                        {
                                            "name": "payloadType",
                                            "type": "string"
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "comments": "3. Data Collection Rule",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "createMajorBuildDCR",
            "subscriptionId": "[variables('workspaceSubscriptionId')]",
            "resourceGroup": "[variables('workspaceResourceGroup')]",
            "dependsOn": [
                "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
                "[resourceId('Microsoft.Resources/deployments', 'createMajorBuildTable')]"
            ],
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "inner"
                },
                "parameters": {
                    "dcrName": {
                        "value": "[variables('dcrName')]"
                    },
                    "dceName": {
                        "value": "[variables('dceName')]"
                    },
                    "workspaceResourceId": {
                        "value": "[parameters('workspaceResourceId')]"
                    },
                    "workspaceSubscriptionId": {
                        "value": "[variables('workspaceSubscriptionId')]"
                    },
                    "workspaceResourceGroup": {
                        "value": "[variables('workspaceResourceGroup')]"
                    }
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "dcrName": {
                            "type": "string"
                        },
                        "dceName": {
                            "type": "string"
                        },
                        "workspaceResourceId": {
                            "type": "string"
                        },
                        "workspaceSubscriptionId": {
                            "type": "string"
                        },
                        "workspaceResourceGroup": {
                            "type": "string"
                        }
                    },
                    "resources": [
                        {
                            "name": "[parameters('dcrName')]",
                            "type": "Microsoft.Insights/dataCollectionRules",
                            "apiVersion": "2022-06-01",
                            "location": "[resourceGroup().location]",
                            "properties": {
                                "dataCollectionEndpointId": "[resourceId(parameters('workspaceSubscriptionId'), parameters('workspaceResourceGroup'), 'Microsoft.Insights/dataCollectionEndpoints', parameters('dceName'))]",
                                "streamDeclarations": {
                                    "Custom-MajorBuildInvocations_CL": {
                                        "columns": [
                                            {
                                                "name": "invocationId",
                                                "type": "string"
                                            },
                                            {
                                                "name": "time",
                                                "type": "string"
                                            },
                                            {
                                                "name": "resourceName",
                                                "type": "string"
                                            },
                                            {
                                                "name": "applicationName",
                                                "type": "string"
                                            },
                                            {
                                                "name": "resourceType",
                                                "type": "string"
                                            },
                                            {
                                                "name": "environment",
                                                "type": "string"
                                            },
                                            {
                                                "name": "userName",
                                                "type": "string"
                                            },
                                            {
                                                "name": "userEmail",
                                                "type": "string"
                                            },
                                            {
                                                "name": "status",
                                                "type": "string"
                                            },
                                            {
                                                "name": "payload",
                                                "type": "dynamic"
                                            },
                                            {
                                                "name": "accountName",
                                                "type": "string"
                                            }
                                        ]
                                    }
                                },
                                "destinations": {
                                    "logAnalytics": [
                                        {
                                            "workspaceResourceId": "[parameters('workspaceResourceId')]",
                                            "name": "clv2ws1"
                                        }
                                    ]
                                },
                                "dataFlows": [
                                    {
                                        "streams": [
                                            "Custom-MajorBuildInvocations_CL"
                                        ],
                                        "destinations": [
                                            "clv2ws1"
                                        ],
                                        "outputStream": "Custom-MajorBuildInvocations_CL",
                                        "transformKql": "source | extend TimeGenerated = todatetime(['time']), invocationTime = tostring(['time']), accountName = tostring(accountName), payloadSubtype = tostring(payload.subtype), payloadTimeoutMs = toint(payload.timeoutMs), payloadType = tostring(payload.type) | project TimeGenerated, accountName, invocationId, invocationTime, resourceName, applicationName, resourceType, environment, userName, userEmail, status, payload, payloadSubtype, payloadTimeoutMs, payloadType"
                                    }
                                ]
                            }
                        }
                    ],
                    "outputs": {
                        "dcrImmutableId": {
                            "type": "string",
                            "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName')), '2022-06-01').immutableId]"
                        }
                    }
                }
            }
        },
        {
            "comments": "4. CCF connector definition (shared UI). Connections are added later from the connector page.",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "createMajorBuildConnector",
            "subscriptionId": "[variables('workspaceSubscriptionId')]",
            "resourceGroup": "[variables('workspaceResourceGroup')]",
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'createMajorBuildDCR')]"
            ],
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "inner"
                },
                "parameters": {
                    "workspace": {
                        "value": "[parameters('workspace')]"
                    },
                    "workspaceResourceId": {
                        "value": "[parameters('workspaceResourceId')]"
                    },
                    "location": {
                        "value": "[variables('location')]"
                    },
                    "connectorDefinitionName": {
                        "value": "[variables('connectorDefinitionName')]"
                    },
                    "tableName": {
                        "value": "[variables('tableName')]"
                    }
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "workspace": {
                            "type": "string"
                        },
                        "workspaceResourceId": {
                            "type": "string"
                        },
                        "location": {
                            "type": "string"
                        },
                        "connectorDefinitionName": {
                            "type": "string"
                        },
                        "tableName": {
                            "type": "string"
                        }
                    },
                    "resources": [
                        {
                            "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/', parameters('connectorDefinitionName'))]",
                            "apiVersion": "2025-07-01-preview",
                            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
                            "location": "[parameters('location')]",
                            "kind": "Customizable",
                            "properties": {
                                "connectorUiConfig": {
                                    "id": "[parameters('connectorDefinitionName')]",
                                    "title": "Major.build Invocations",
                                    "publisher": "Major.build",
                                    "descriptionMarkdown": "The **[Major.build](https://major.build) Invocations** connector ingests AI agent invocation logs from the Major.build platform into Microsoft Sentinel. Each record captures which user triggered an invocation, which application and resource integration was used, and the full request payload \u2014 including API paths called or SQL queries executed by AI agents.\n\nThe connector supports multiple Major.build accounts in one workspace. Each connection is added independently, labeled by account name, and listed in the connections grid. Use this data to monitor user activity, detect anomalous AI-driven API patterns, audit database queries executed by agents, and correlate automation activity with your broader security posture.",
                                    "graphQueriesTableName": "[parameters('tableName')]",
                                    "graphQueries": [
                                        {
                                            "metricName": "Total invocations received",
                                            "legend": "Major.build Invocations",
                                            "baseQuery": "[parameters('tableName')]"
                                        }
                                    ],
                                    "sampleQueries": [
                                        {
                                            "description": "All invocations \u2014 most recent first",
                                            "query": "MajorBuildInvocations_CL\n| sort by TimeGenerated desc"
                                        },
                                        {
                                            "description": "Invocations by Major.build account (last 7 days)",
                                            "query": "MajorBuildInvocations_CL\n| where TimeGenerated > ago(7d)\n| summarize InvocationCount = count() by accountName\n| sort by InvocationCount desc"
                                        },
                                        {
                                            "description": "Invocations by user (last 7 days)",
                                            "query": "MajorBuildInvocations_CL\n| where TimeGenerated > ago(7d)\n| summarize InvocationCount = count() by userEmail, userName, accountName\n| sort by InvocationCount desc"
                                        },
                                        {
                                            "description": "Failed invocations (last 24 hours)",
                                            "query": "MajorBuildInvocations_CL\n| where TimeGenerated > ago(24h) and status != 'success'\n| project TimeGenerated, accountName, userEmail, applicationName, resourceName, resourceType, status, payloadType, payload.path"
                                        },
                                        {
                                            "description": "Database queries executed by AI agents",
                                            "query": "MajorBuildInvocations_CL\n| where TimeGenerated > ago(24h) and payloadType == 'database'\n| project TimeGenerated, accountName, userEmail, applicationName, resourceName, payload['sql']\n| sort by TimeGenerated desc"
                                        },
                                        {
                                            "description": "Top API paths called by AI agents",
                                            "query": "MajorBuildInvocations_CL\n| where TimeGenerated > ago(7d) and payloadType == 'api'\n| summarize Count = count() by accountName, tostring(payload.method), tostring(payload.path)\n| sort by Count desc"
                                        }
                                    ],
                                    "dataTypes": [
                                        {
                                            "name": "[parameters('tableName')]",
                                            "lastDataReceivedQuery": "MajorBuildInvocations_CL\n| where TimeGenerated > ago(12h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                                        }
                                    ],
                                    "connectivityCriteria": [
                                        {
                                            "type": "HasDataConnectors",
                                            "value": []
                                        }
                                    ],
                                    "availability": {
                                        "status": 1,
                                        "isPreview": true
                                    },
                                    "permissions": {
                                        "resourceProvider": [
                                            {
                                                "provider": "Microsoft.OperationalInsights/workspaces",
                                                "permissionsDisplayText": "Read and Write permissions are required.",
                                                "providerDisplayName": "Workspace",
                                                "scope": "Workspace",
                                                "requiredPermissions": {
                                                    "write": true,
                                                    "read": true,
                                                    "delete": true
                                                }
                                            }
                                        ],
                                        "customs": [
                                            {
                                                "name": "Major.build API key",
                                                "description": "A valid API key from each Major.build account is required. Keys begin with **MJR_** and can be generated from Major.build platform settings. Connect one key per account."
                                            }
                                        ]
                                    },
                                    "instructionSteps": [
                                        {
                                            "title": "Prerequisites",
                                            "description": "",
                                            "instructions": [
                                                {
                                                    "type": "Markdown",
                                                    "parameters": {
                                                        "content": "#### Prerequisites\n\n- One or more Major.build accounts with API access enabled\n- An API key for each account you want to connect. Keys begin with `MJR_`.\n\n#### Get an API key\n\n1. Sign in to the **[Major.build platform](https://major.build)**\n2. Go to **Settings \u2192 API Keys**\n3. Generate a new key or copy an existing one\n4. Copy the full value (it starts with `MJR_`)\n\n> Keep each key secure. Anyone with a key can query that account's invocation history, including SQL text and API paths executed by AI agents.\n\nAfter the solution is installed, use **Add connection** to connect each Major.build account. Connecting a second account does not overwrite the first."
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "title": "Major.build connections",
                                            "description": "Add and manage connections to your Major.build accounts. You can connect multiple accounts at the same time.",
                                            "instructions": [
                                                {
                                                    "type": "DataConnectorsGrid",
                                                    "parameters": {
                                                        "mapping": [
                                                            {
                                                                "columnName": "Account name",
                                                                "columnValue": "properties.addOnAttributes.accountName"
                                                            },
                                                            {
                                                                "columnName": "Data type",
                                                                "columnValue": "properties.dataType"
                                                            }
                                                        ],
                                                        "menuItems": [
                                                            "DeleteConnector"
                                                        ]
                                                    }
                                                },
                                                {
                                                    "type": "ContextPane",
                                                    "parameters": {
                                                        "label": "Add connection",
                                                        "title": "Add Major.build connection",
                                                        "subtitle": "Connect a Major.build account to Microsoft Sentinel",
                                                        "contextPaneType": "DataConnectorsContextPane",
                                                        "instructionSteps": [
                                                            {
                                                                "instructions": [
                                                                    {
                                                                        "type": "Textbox",
                                                                        "parameters": {
                                                                            "label": "Account name",
                                                                            "placeholder": "e.g. production, staging, or customer-a",
                                                                            "type": "text",
                                                                            "name": "accountName",
                                                                            "validations": {
                                                                                "required": true
                                                                            }
                                                                        }
                                                                    },
                                                                    {
                                                                        "type": "Textbox",
                                                                        "parameters": {
                                                                            "label": "Major.build API key",
                                                                            "placeholder": "MJR_...",
                                                                            "type": "password",
                                                                            "name": "apiKey",
                                                                            "validations": {
                                                                                "required": true
                                                                            }
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        }
    ],
    "outputs": {
        "tableName": {
            "type": "string",
            "value": "[variables('tableName')]"
        },
        "dcrName": {
            "type": "string",
            "value": "[variables('dcrName')]"
        },
        "connectorDefinitionName": {
            "type": "string",
            "value": "[variables('connectorDefinitionName')]"
        }
    }
}
